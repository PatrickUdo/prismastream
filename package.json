{
	"name": "prismastream",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:core": "vite build --config vite.core.config.ts",
		"build:core:node": "vite build --config vite.core.node.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"sync": "vite build && cap sync",
		"ios": "vite build && cap sync ios && cap open ios",
		"android": "vite build && cap sync android && cap open android",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.1.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@aparajita/capacitor-secure-storage": "^8.0.1",
		"@capacitor/android": "^8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.5.3",
		"@capacitor/ios": "^8.5.3",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/screen-orientation": "^8.0.2",
		"@capacitor/status-bar": "^8.0.4",
		"@fontsource-variable/manrope": "^5.3.0",
		"hls.js": "^1.7.3",
		"idb-keyval": "^6.3.0",
		"saxes": "^6.0.0"
	}
}
