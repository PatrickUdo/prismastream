# Copy to .env (dev) or pass as build args. Vite only exposes variables prefixed with VITE_.

# Backend for the catalog, sources, play urls and the E2E sync (one server). Without it the app
# runs in local mode (sources fetched and merged on the device).
VITE_BACKEND_URL=https://backend.prismastream.patrickudo.nl

# Demo library with fictional titles. true in development and tests, false in production
# (no demo source, and the demo data is left out of the bundle).
VITE_DEMO=true
